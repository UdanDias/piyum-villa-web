.swal2-popup.pv-toast, .swal2-popup.pv-confirm { font-family: inherit; background: #fffdf7; color: #302125; border: 1px solid #dfd2be; border-radius: 14px; }
.dark .swal2-popup.pv-toast, .dark .swal2-popup.pv-confirm { background: #332329; color: #fff5dc; border-color: #665058; }
.swal2-popup.pv-toast { padding: 10px 12px; max-width: calc(100vw - 24px); box-shadow: 0 8px 30px #0003; }
.swal2-popup.pv-toast .pv-toast-title { margin: 4px 8px; font-family: inherit; font-size: 14px; line-height: 1.45; font-weight: 500; overflow-wrap: anywhere; text-align: left; }
.swal2-popup.pv-toast-error .pv-toast-title, .pv-confirm .swal2-validation-message { color: #ff3030; }
.swal2-popup.pv-toast .swal2-icon { margin: 0 6px 0 0; }
.swal2-popup.pv-toast .swal2-close { font-size: 22px; width: 22px; height: 26px; margin: 0; }
.swal2-popup.pv-confirm { max-width: calc(100vw - 24px); padding-bottom: 24px; }
.pv-confirm .swal2-title { font-family: inherit; font-size: 24px; line-height: 1.3; }
.pv-confirm .swal2-html-container { font-size: 15px; line-height: 1.6; }
.pv-confirm label { display: block; text-align: left; margin-top: 12px; }
.pv-confirm .swal2-input, .pv-confirm .swal2-select { display: block; width: 100%; margin: 6px 0; color: inherit; background: inherit; box-sizing: border-box; }
.pv-confirm .swal2-validation-message { background: transparent; }
.pv-notice-container { z-index: 20000; }
@media (prefers-reduced-motion: reduce) { .pv-toast, .pv-confirm { animation: none !important; } }
